<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone read-only diagnostic. Does not reference or install a virtual gamepad driver. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WinDockGamepadProbe</AssemblyName>
  </PropertyGroup>
</Project>
