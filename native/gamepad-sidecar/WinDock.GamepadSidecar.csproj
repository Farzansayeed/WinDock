    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../gamepad-tests/GamepadState.cs" Link="GamepadState.cs" />
    <Compile Include="../gamepad-tests/GamepadReceiver.cs" Link="GamepadReceiver.cs" />
  </ItemGroup>
</Project>
